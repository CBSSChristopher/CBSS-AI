{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbsscrm",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["15 6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "cache": {
    "enabled": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "CRM_STORE",
      "id": "257a2e17e41b4662b0f8ac164f91d7ca"
    }
  ]
}

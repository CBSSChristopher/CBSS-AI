{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbsscompletetool",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "CRM_STORE", "id": "257a2e17e41b4662b0f8ac164f91d7ca" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "browser": {
    "binding": "BROWSER"
  }
}

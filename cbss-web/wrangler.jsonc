{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbssweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "cbshippingsolutions.app", "custom_domain": true },
    { "pattern": "www.cbshippingsolutions.app", "custom_domain": true }
  ]
}
